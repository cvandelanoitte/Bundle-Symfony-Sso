{
    "name": "issl/sso-bundle",
    "description": "OpenID Connect single sign-on for the ISSL Symfony apps: browser login (Authorization Code + PKCE), bearer-token APIs and local user provisioning.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "keywords": ["symfony", "bundle", "openid-connect", "oidc", "sso", "keycloak"],
    "require": {
        "php": ">=8.4",
        "psr/clock": "^1.0",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/translation-contracts": "^3.5",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0 || ^13.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Issl\\SsoBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Issl\\SsoBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
